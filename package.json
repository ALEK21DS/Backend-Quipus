{
  "name": "proyecto-quipus-backend",
  "version": "1.0.0",
  "description": "Backend para el juego educativo Proyecto Quipus",
  "main": "src/app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npx prisma generate",
    "postinstall": "npx prisma generate",
    "vercel-build": "npx prisma generate",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:setup": "node setup-database.js",
    "db:seed": "node prisma/seed.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f quipus-backend"
  },
  "keywords": ["educacion", "matematicas", "juego", "quipus"],
  "author": "Proyecto Quipus",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "prisma": "^5.7.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}