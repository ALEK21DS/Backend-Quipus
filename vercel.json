{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@2.15.10",
      "maxDuration": 30
    },
    "api/test.js": {
      "runtime": "@vercel/node@2.15.10",
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/test",
      "dest": "/api/test.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "installCommand": "npm install --no-audit --no-fund --legacy-peer-deps",
  "env": {
    "NODE_ENV": "production"
  }
}
