{
  "version": 2,
  "buildCommand": "node vercel-build.js",
  "installCommand": "npm install && npx prisma generate",
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node",
      "maxDuration": 30
    },
    "api/test.js": {
      "runtime": "@vercel/node",
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/test",
      "dest": "/api/test.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
